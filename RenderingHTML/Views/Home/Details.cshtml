@*
    MODEL BINDING — Views/Home/Details.cshtml

    @model      : Declares the type of data this view receives (a single Student object).

    @Model.X    : Razor expression that renders the bound model property as HTML-encoded text.
                  Data flow: Controller creates Student → passes via return View(student)
                  → Razor outputs it here with @Model.PropertyName.

    TAG HELPER:
      asp-action on <a> generates the correct URL without hard-coding any path.
*@
@model RenderingHTML.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Course</dt>
    <dd class="col-sm-10">@Model.Course</dd>

    <dt class="col-sm-2">Age</dt>
    <dd class="col-sm-10">@Model.Age</dd>
</dl>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to List</a>
